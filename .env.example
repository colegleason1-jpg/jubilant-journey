# ── eBay (docs/04) ───────────────────────────────────────────────────────────────
# developer.ebay.com → production keyset. Browse API only; never scrape.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# eBay Partner Network campaign id — commission on our own purchases
EBAY_EPN_CAMPAIGN_ID=

# ── WatchCharts (docs/04 J2) ─────────────────────────────────────────────────────
# Requires a Professional membership. Metered by data credits.
# NOTE: internal-use licence only covers internal use. Publishing comp data on the
# storefront requires a distribution licence. See docs/07.
WATCHCHARTS_API_KEY=

# ── Stripe (docs/06) ─────────────────────────────────────────────────────────────
# Every PaymentIntent MUST use capture_method: 'manual'.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Supabase (docs/05) ───────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Reddit demand signal (docs/04 J4) — official API, read-only ──────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gleason-timepiece-demand-signal/0.1 (contact: you@example.com)

# ── Alerts ───────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=

# ── Business config ──────────────────────────────────────────────────────────────
HAS_RESALE_CERTIFICATE=true
HOME_STATE_SALES_TAX_RATE=0.075

# ── Alerts (email, not Discord) ──────────────────────────────────────────────────
# Resend free tier: 3,000/month but only 100/DAY — the daily cap is the binding one.
ALERT_FROM_EMAIL=scout@gleasontimepiece.org
ALERT_TO_EMAIL=

# ── Fulfilment routing (docs/13) ─────────────────────────────────────────────────
# Where $1,000+ watches (and everything for the first 20 orders) is shipped before
# it goes to the customer.
#
# 🔒 Your street address lives HERE, not in git. Even in a private repo, an address
# in version control leaks the moment the repo is shared, forked or made public.
HIGH_VALUE_SHIP_TO_NAME=
HIGH_VALUE_SHIP_TO_STREET=
HIGH_VALUE_SHIP_TO_CITY=
HIGH_VALUE_SHIP_TO_STATE=
HIGH_VALUE_SHIP_TO_ZIP=
# Order value at or above which we always route through you (docs/13).
OPERATOR_ROUTING_THRESHOLD_USD=1000
# Clean orders required before direct-ship is allowed at all.
MIN_COMPLETED_ORDERS_FOR_DIRECT=20

# ── Scout runtime (docs/11) ──────────────────────────────────────────────────────
# GitHub Actions rounds every job UP to a whole minute: 61s costs double 59s.
SCOUT_DEADLINE_SECONDS=45
SCOUT_MAX_WORKERS=8
SCOUT_DRY_RUN=false

# ── Margin floors ────────────────────────────────────────────────────────────────
# Normally UNSET: floors are per price tier (see packages/core/src/tiers.ts), because
# a single percentage gets both ends of the range wrong. 30% on a $30 watch, 1% on a
# $10,000 one. These override every tier at once — for experiments only.
# MIN_MARGIN_PCT_OVERRIDE=
# MIN_GROSS_PROFIT_USD_OVERRIDE=
MIN_DISCOUNT_TO_MARKET_PCT=0.18
TARGET_DISCOUNT_TO_MARKET=0.10
